# Bosque — variables de entorno
# Copiar a .env.local y completar con credenciales reales.

# Modo de pago: simulated (default, sin tocar MP) | production (MP real)
PAYMENT_MODE=simulated

# Database — Neon Postgres
DATABASE_URL=postgres://...

# Mercado Pago — productive credentials
# Solo necesarias si PAYMENT_MODE=production
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Resend — email transaccional
RESEND_API_KEY=
RESEND_FROM=hola@bosque.example

# App — base URL para webhooks y emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin — token simple para proteger panel /admin
ADMIN_TOKEN=

# Session signing — HMAC secret para cookie session_id del carrito
SESSION_SECRET=
